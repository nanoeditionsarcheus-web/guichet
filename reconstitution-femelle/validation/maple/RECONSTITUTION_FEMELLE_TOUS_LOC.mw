<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 1" layout="Heading 1"><Font size="14" encoding="UTF-8">D\303\251finitions de fonctions</Font></Text-field></Title>
<Group labelreference="L75" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">compat:=proc(loc_juv,loc_candidat)
local intersection;
intersection:={op(loc_juv)} intersect {op(loc_candidat)};
`if`(nops(intersection)= 0,0,1);
end proc:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">nb_compatibles:=proc(loc_candidat,juv_un_loc)
convert([seq(compat(juv_un_loc[i],loc_candidat),i=1..nops(juv_un_loc))],`+`);
end proc:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">en_alleles:=proc(genot)
[iquo(genot,1000),irem(genot,1000)]
end proc:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">transp := proc (liste_de_listes) local j, i; options operator, arrow; [seq([seq
(liste_de_listes[i][j],i = 1 .. nops(liste_de_listes))],j = 1 .. nops(
liste_de_listes[1]))] end:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">convert_en_3_digits_un_genot:=proc(genot)
map(en_alleles,genot);
end proc:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">liste_des_compat_un_loc:=proc(data_2_3_par_locus,ind_loc)
local juv_un_loc,juv_un_loc_non_0,max_compat,liste_alleles_loc,liste_des_candidats,nb_compat_par_candidat,nb_compat_cand,liste_cand_compat;
juv_un_loc :=data_2_3_par_locus[ind_loc]; 
juv_un_loc_non_0:=remove(x-&gt;x=[0,0],juv_un_loc):
max_compat:=nops(juv_un_loc_non_0);
liste_alleles_loc:=[op({op(map(op,juv_un_loc_non_0))})]:
liste_des_candidats:=[op({op(map(sort,[seq(seq([liste_alleles_loc[i],liste_alleles_loc[j]],j=1..nops(liste_alleles_loc)),i=1..nops(liste_alleles_loc))]))})];
nb_compat_par_candidat:=[seq(nb_compatibles(liste_des_candidats[i],juv_un_loc),i=1..nops(liste_des_candidats))];
nb_compat_cand:=[seq([liste_des_candidats[i],nb_compat_par_candidat[i]],i=1..nops(nb_compat_par_candidat))];
liste_cand_compat:=sort(nb_compat_cand,(x,y)-&gt;x[2]&gt;y[2]);
[L||ind_loc,max=max_compat,sort(nb_compat_cand,(x,y)-&gt;x[2]&gt;y[2])];
end proc:</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">nb_allele_un_loc:=proc(un_loc)
local ens_all;
ens_all:=convert(map(op,un_loc),set);
`if`(ens_all={0},0,nops(ens_all))
end proc:</Text-field>
</Input>
</Group>
</Section>
